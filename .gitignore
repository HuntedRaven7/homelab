# Local environment files (secrets)
.env
.env.local
.env.*.local

# Quadlet environment files (user-specific)
~/.config/containers/*.env
quadlets/**/*.env

# SOPS age keys and decrypted files (NEVER commit)
.sops/age.key
.sops/*.dec.yaml
*.age.key

# Systemd
*.service
*.socket
*.timer

# IDE
.vscode/
.idea/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Logs
*.log

# OpenTofu state and secrets
tofu/.tofu/
tofu/*.tfstate
tofu/*.tfstate.*
tofu/.terraform/
tofu/tofu.tfvars
tofu/kubeconfig

.kilo/

