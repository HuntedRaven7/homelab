[Unit]
Description=Hermes Agent (Nous Research)
Documentation=https://github.com/NousResearch/hermes-agent
After=tailscale.service
Requires=tailscale.service

[Container]
Image=docker.io/nousresearch/hermes-agent:latest@sha256:72767f869d46c45de84e7c3879b698a81a913c9fd2c515c18697c2ff9bdaf4d0
ContainerName=hermes-agent
Network=container:tailscale
Volume=/var/lib/hermes-agent:/data:Z
Environment=HERMES_API_KEY=${HERMES_API_KEY}
Environment=HERMES_MODEL=${HERMES_MODEL:-hermes-3-llama-3.1-8b}
Restart=always
RestartSec=10

[Install]
WantedBy=default.target