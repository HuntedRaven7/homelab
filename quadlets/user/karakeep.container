[Unit]
Description=Karakeep Bookmark Manager
Documentation=https://github.com/karakeep-app/karakeep
After=tailscale.service
Requires=tailscale.service

[Container]
Image=ghcr.io/karakeep-app/karakeep:latest@sha256:448e1385fc39f4a1e5ca59f2d7c1ed714a253de9915aabc0c21cf6c56a6771e5
ContainerName=karakeep
Network=container:tailscale
Volume=/var/lib/karakeep:/app/data:Z
Environment=DATABASE_URL=file:/app/data/karakeep.db
Environment=NEXTAUTH_SECRET=${KARAKEEP_NEXTAUTH_SECRET}
Environment=NEXTAUTH_URL=https://karakeep.tailnet.ts.net
Environment=NEXT_PUBLIC_APP_URL=https://karakeep.tailnet.ts.net
Environment=TRUSTED_PROXY=true
Restart=always
RestartSec=10

[Install]
WantedBy=default.target