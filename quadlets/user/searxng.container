[Unit]
Description=SearXNG Privacy-Friendly Search
Documentation=https://docs.searxng.org/
After=tailscale.service
Requires=tailscale.service

[Container]
Image=docker.io/searxng/searxng:latest@sha256:a93b665d10ce0675e8d2124187943111399ba69f384228c51b4cd21fdceda0bc
ContainerName=searxng
Network=container:tailscale
Volume=/etc/searxng:/etc/searxng:Z,ro
Environment=SEARXNG_BASE_URL=https://search.tailnet.ts.net/
Environment=SEARXNG_SECRET_KEY=${SEARXNG_SECRET_KEY}
Environment=SEARXNG_REDIS_URL=redis://redis:6379/0
Environment=SEARXNG_LIMITER=false
Restart=always
RestartSec=10

[Install]
WantedBy=default.target