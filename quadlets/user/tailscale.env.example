# Tailscale Configuration
# Copy this file to ~/.config/containers/tailscale.env and fill in your values
# Then run: systemctl --user daemon-reload && systemctl --user enable --now tailscale

# Get your auth key from https://login.tailscale.com/admin/settings/keys
TAILSCALE_AUTH_KEY=tskey-auth-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Optional: Set a custom hostname for this node in Tailscale
# HOSTNAME=my-homelab-server

# Optional: Additional Tailscale flags
# TS_EXTRA_ARGS=--accept-routes --advertise-routes=192.168.1.0/24 --advertise-exit-node