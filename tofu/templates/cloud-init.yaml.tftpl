#cloud-config
# Cloud-init configuration for k0s nodes
# This runs on first boot to configure the node

# Set hostname
hostname: k0s-node

# Configure timezone
timezone: America/Toronto

# Configure locale
locale: en_US.UTF-8

# Users
users:
  - name: robin
    sudo: ALL=(ALL) NOPASSWD:ALL
    shell: /bin/bash
    ssh_authorized_keys:
      - ${ssh_public_key}
    lock_passwd: false

# Write files
write_files:
  - path: /etc/modules-load.d/k8s.conf
    content: |
      overlay
      br_netfilter
  - path: /etc/sysctl.d/k8s.conf
    content: |
      net.bridge.bridge-nf-call-iptables  = 1
      net.bridge.bridge-nf-call-ip6tables = 1
      net.ipv4.ip_forward                 = 1

# Enable services
bootcmd:
  - modprobe overlay
  - modprobe br_netfilter
  - sysctl --system

# Final configuration
final_message: "k0s node ready after $UPTIME seconds"